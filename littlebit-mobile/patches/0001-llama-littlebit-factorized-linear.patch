     const buft_list_t * buft_list_layer = nullptr;
     if (tn.bid != -1) {
         // blocks that are not model layers (e.g. the blocks of a head) go with the output
@@ -2542,6 +2549,55 @@ ggml_tensor * llama_model_base::create_tensor(llama_model_loader & ml, const LLM
         tn, ne, flags);
 }
 
+ggml_tensor * llama_model_base::create_tensor_littlebit(llama_model_loader & ml, const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags) {
+    const std::string name = tn.str();
+    if (ml.get_weight(name.c_str()) != nullptr) {
+        return nullptr; // dense weight present
+    }
+    const std::string base = name.substr(0, name.size() - strlen("weight"));
+    if (ml.get_weight((base + "lb_v").c_str()) == nullptr) {
+        return nullptr; // not a LittleBit weight either
+    }
+    GGML_ASSERT(ne.size() == 2 && "LittleBit factorization is only supported for 2D weights");
+    const int64_t n_in  = ne.begin()[0];
+    const int64_t n_out = ne.begin()[1];
+
+    auto load_branch = [&](const char * sv, const char * su, const char * ssi, const char * ssm, const char * sso,
+                           llama_littlebit_branch & br) -> bool {
+        const std::string nv = base + sv;
+        ggml_tensor * mv = ml.get_tensor_meta(nv.c_str());
+        if (mv == nullptr) {
+            return false;
+        }
+        const int64_t n_lat = mv->ne[1];
+        if (mv->ne[0] != n_in) {
+            throw std::runtime_error(format("%s: expected n_in = %lld, got %lld", nv.c_str(), (long long) n_in, (long long) mv->ne[0]));
+        }
+        const LLM_TN_IMPL tv (tn.arch, tn.tensor, sv,  tn.bid, tn.xid);
+        const LLM_TN_IMPL tu (tn.arch, tn.tensor, su,  tn.bid, tn.xid);
+        const LLM_TN_IMPL tsi(tn.arch, tn.tensor, ssi, tn.bid, tn.xid);
+        const LLM_TN_IMPL tsm(tn.arch, tn.tensor, ssm, tn.bid, tn.xid);
+        const LLM_TN_IMPL tso(tn.arch, tn.tensor, sso, tn.bid, tn.xid);
+        const int f = flags & ~TENSOR_NOT_REQUIRED;
+        br.v     = create_tensor(ml, tv,  {n_in,  n_lat}, f);
+        br.u     = create_tensor(ml, tu,  {n_lat, n_out}, f);
+        br.s_in  = create_tensor(ml, tsi, {n_in},         f);
+        br.s_mid = create_tensor(ml, tsm, {n_lat},        f);
+        br.s_out = create_tensor(ml, tso, {n_out},        f);
+        return true;
+    };
+
+    llama_littlebit_weight lw;
+    load_branch("lb_v",   "lb_u",   "lb_s_in",   "lb_s_mid",   "lb_s_out",   lw.main);
+    load_branch("lb_r_v", "lb_r_u", "lb_r_s_in", "lb_r_s_mid", "lb_r_s_out", lw.res);
+
+    if (lw.main.u == nullptr) {
+        return nullptr; // e.g. a skipped tensor
+    }
+    littlebit.emplace(lw.main.u, lw);
+    return lw.main.u;
+}
