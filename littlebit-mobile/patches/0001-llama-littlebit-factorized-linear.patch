diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 269b920..865908f 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1809,6 +1809,28 @@ ggml_tensor * llm_graph_context::build_lora_mm(
           ggml_tensor * w,
           ggml_tensor * cur,
           ggml_tensor * w_s) const {
+    if (!model.littlebit.empty()) {
+        const auto it = model.littlebit.find(w);
+        if (it != model.littlebit.end()) {
+            // LittleBit: y = s_out * (U @ (s_mid * (V @ (s_in * x)))) [+ residual branch]
+            auto branch = [&](const llama_littlebit_branch & br) {
+                ggml_tensor * t = ggml_mul(ctx0, cur, br.s_in);
+                t = ggml_mul_mat(ctx0, br.v, t);
+                t = ggml_mul(ctx0, t, br.s_mid);
+                t = ggml_mul_mat(ctx0, br.u, t);
+                return ggml_mul(ctx0, t, br.s_out);
+            };
+            ggml_tensor * res = branch(it->second.main);
+            if (it->second.res.v) {
+                res = ggml_add(ctx0, res, branch(it->second.res));
+            }
+            if (w_s) {
+                res = ggml_mul(ctx0, res, w_s);
+            }
+            return res;
+        }
+    }
+
     // a Hadamard-folded weight reads the transformed input; a LoRA delta lives in the primal basis and reads `cur`
     ggml_tensor * cur_mm = build_hadamard_input(w, cur);
     ggml_tensor * res = ggml_mul_mat(ctx0, w, cur_mm);
