diff --git a/src/llama-model.h b/src/llama-model.h
index 8d2f562..12e8b94 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -787,6 +787,25 @@ struct llama_hadamard {
     llama_hadamard_rotations inv; // latent lookup table -> inverse transform
 };
 
+// LittleBit / LittleBit-2 sub-1-bit factorized linear layer (arXiv:2506.13771, arXiv:2603.00042)
+// W ~= diag(s_out) * U * diag(s_mid) * V * diag(s_in), with U and V holding only {-1,0,+1} (stored as TQ1_0)
+// the optional residual branch has the same form and is added to the main branch
+struct llama_littlebit_branch {
+    ggml_tensor * v     = nullptr; // [n_in,  n_lat] binary latent factor V
+    ggml_tensor * u     = nullptr; // [n_lat, n_out] binary latent factor U
+    ggml_tensor * s_in  = nullptr; // [n_in]  input scale  (v2)
+    ggml_tensor * s_mid = nullptr; // [n_lat] latent scale (v1 * u2)
+    ggml_tensor * s_out = nullptr; // [n_out] output scale (u1)
+};
+
+struct llama_littlebit_weight {
+    llama_littlebit_branch main;
+    llama_littlebit_branch res;    // res.v == nullptr if there is no residual branch
+};
+
+// keyed by the tensor returned from create_tensor() in place of the dense weight (main.u)
+using llama_littlebit_weights = std::unordered_map<const ggml_tensor *, llama_littlebit_weight>;
+
 struct llama_rope_params {
     int32_t n_rot      = 0; // 0 if the layer has no RoPE
     int32_t n_offs     = 0; // first rotated dim in a cached K head
@@ -818,6 +837,9 @@ struct llama_model {
 
     llama_hadamard hdmd;
 
+    // LittleBit factorized weights, empty for ordinary models
+    llama_littlebit_weights littlebit;
+
     // see llama_model_set_attn_rot
     bool attn_rot = true;
 
@@ -1095,6 +1117,9 @@ struct llama_model_base : public llama_model {
 
     ggml_tensor * create_tensor(llama_model_loader & ml, const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags);
 
+    // LittleBit: create the latent factors of a factorized weight, returns nullptr if the weight is not factorized
+    ggml_tensor * create_tensor_littlebit(llama_model_loader & ml, const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags);
+
     // convenience overload of create_tensor that doesn't require llama_model_loader
     ggml_tensor * create_tensor(const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags);
 
